# Copy this file to .env and fill in real values. Never commit the real .env file.

# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/event-booking?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Razorpay (use TEST mode keys from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# CORS - the deployed frontend URL
CLIENT_URL=http://localhost:5173
